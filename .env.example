# 모델 API 키 (flue run / vite dev가 .env를 자동으로 읽음)
ANTHROPIC_API_KEY=""
# 기본값 anthropic/claude-sonnet-5-5
MODEL=""

# @BotFather에서 만든 봇 토큰
